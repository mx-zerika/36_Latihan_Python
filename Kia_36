def perulangan_ganjil_genap():
    while True:
        nilai = int(input("masukkan nilai:"))

        if nilai % 2 == 0:
            print("nilai", nilai, "adalah bilangan genap")
        else:
            print("nilai", nilai, "adalah bilangan ganjil")

def bilangan_prima():
    while True:
        angka = int(input("masukkan angka:"))

        if angka % 2 == 0:
            print("angka", angka, "adalah bilangan prima")
        else:
            print("angka", angka, "bukanlah bilangan prima")

perulangan_ganjil_genap()
bilangan_prima()
